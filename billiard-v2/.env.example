# Copy file ini jadi .env (untuk dev lokal) atau set values di Railway/Vercel dashboard.
# JANGAN commit .env asli — sudah di-ignore di .gitignore.
#
# Generate JWT_SECRET random: openssl rand -hex 32
# Atau Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Auth: JWT signing key ──────────────────────────────────────
JWT_SECRET=ganti-dengan-random-string-min-32-char
JWT_EXPIRES=24h

# ── PIN: REST API /api/v1/auth ─────────────────────────────────
ADMIN_PIN=
KASIR_PIN=

# ── PIN: Admin dashboard /admin (per-user) ─────────────────────
OWNER_ADMIN_PIN=
KARYAWAN1_ADMIN_PIN=
KARYAWAN2_ADMIN_PIN=
KARYAWAN3_ADMIN_PIN=

# ── PIN: /operasional (finance) ────────────────────────────────
OWNER_PIN=
KARYAWAN_PIN=
FINANCE_PIN=

# ── PIN: modul SDM ─────────────────────────────────────────────
SDM_PIN=
SDM_SECRET=ganti-dengan-random-string-min-16-char

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cloudinary (optional, untuk QR upload) ─────────────────────
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ── Konfigurasi non-sensitif (optional, ada default) ───────────
# PORT=3000
# NAMA_ARENA=Warpat Jombang
# BATAS_MAIN=10
# BATAS_HARI=30
# KODE_PREFIX=JMB
# NOMOR_WA=6281519210552
# BUSINESS_DAY_CUTOFF_HOUR=6
